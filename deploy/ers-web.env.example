# Copy to /opt/ers/ers-web.env on the server (chmod 600, owned by the `ers` user).
# This is loaded via systemd's EnvironmentFile= — see deploy/systemd/ers-web.service.

# Only uncomment/change this if port 8080 is already used by something else on the box.
# If you do, update the proxy_pass port in deploy/nginx/ers.conf to match.
# SERVER_PORT=8081

# REQUIRED for any real domain - the backend rejects browser requests from origins not listed
# here (CORS). The default only allows localhost, which is fine for local dev but will make
# every login/API call fail with "Invalid CORS request" once you're serving a real domain.
# Comma-separated, supports * wildcards.
ERS_CORS_ALLOWED_ORIGINS=https://ers.example.com

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ers
DB_USER=ers
DB_PASSWORD=change-me-strong-password

# Generate with: openssl rand -base64 48
ERS_JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long

ERS_ADMIN_USERNAME=admin
ERS_ADMIN_PASSWORD=change-me-strong-password

# Leave unset in production: the default profile emits JSON logs to stdout, which
# systemd/journald captures. Only set SPRING_PROFILES_ACTIVE=local for readable
# console logs during manual debugging on the box.

# Seeds ~40 rows of demo data (users, transactions, breaks, adjustments) on first boot.
# Set to false once you're past the demo/eval stage and moving real data through the system.
ERS_DEMO_ENABLED=true

# The embedded LDAP test server (ERS_LDAP_EMBEDDED=true) is for local dev/demo only - it's an
# anonymous-bind directory with no real security, and it opens a port (default 11389) that must
# never be reachable from outside this box. If you don't have a real AD/LDAP to point at yet, the
# safest choice on a public VPS is ERS_LDAP_ENABLED=false (local username/password login only).
# To point at a real AD later: ERS_LDAP_ENABLED=true, ERS_LDAP_EMBEDDED=false, and set
# ERS_LDAP_URLS/ERS_LDAP_BASE/ERS_LDAP_MANAGER_DN/ERS_LDAP_MANAGER_PASSWORD below.
ERS_LDAP_ENABLED=false
# ERS_LDAP_EMBEDDED=false
# ERS_LDAP_URLS=ldaps://your-ad-host:636
# ERS_LDAP_BASE=dc=yourcompany,dc=com
# ERS_LDAP_MANAGER_DN=cn=svc-ers,ou=service-accounts,dc=yourcompany,dc=com
# ERS_LDAP_MANAGER_PASSWORD=change-me
