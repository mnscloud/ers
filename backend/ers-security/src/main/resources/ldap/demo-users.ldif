# Demo directory for the embedded test LDAP server (local dev only).
# Passwords below are throwaway credentials for this in-memory test server - not real secrets.
# Note: the root "dc=ers,dc=local" entry is NOT defined here - UnboundIdContainer creates it
# automatically from its defaultPartitionSuffix constructor arg, and re-declaring it in the LDIF
# causes a duplicate-entry error at startup.

dn: ou=people,dc=ers,dc=local
objectClass: top
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=ers,dc=local
objectClass: top
objectClass: organizationalUnit
ou: groups

dn: uid=ldap.admin,ou=people,dc=ers,dc=local
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: ldap.admin
cn: Laura Admin
sn: Admin
mail: ldap.admin@ers.local
userPassword: ldap123

